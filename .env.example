COMPOSE_PROJECT_NAME=tour-platform

# Local-only application settings. Run `make bootstrap` to create .env and APP_KEY.
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
WEB_URL=http://localhost:3000

POSTGRES_DB=tour_platform
POSTGRES_USER=tour_platform
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Logical Redis databases isolate eviction and flush boundaries by concern.
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_RATE_LIMIT_DB=3
REDIS_PRESENCE_DB=4
REDIS_REALTIME_DB=5
REDIS_PORT=6379

MINIO_ROOT_USER=tour_local
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET=tour-platform-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8080
WEB_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

